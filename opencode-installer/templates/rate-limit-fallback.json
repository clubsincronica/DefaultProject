{
  "enabled": true,
  "cooldownMs": 300000,
  "fallbackMode": "cycle",
  "enableSubagentFallback": true,
  "fallbackModels": [
    { "providerID": "opencode", "modelID": "deepseek-v4-flash-free" },
    { "providerID": "nvidia", "modelID": "deepseek-ai/deepseek-v4-flash-0731" },
    { "providerID": "openrouter", "modelID": "~deepseek/deepseek-v4-flash-latest" },
    { "providerID": "nvidia", "modelID": "moonshotai/kimi-k2.6" },
    { "providerID": "nvidia", "modelID": "nvidia/llama-3.3-nemotron-super-49b-v1" },
    { "providerID": "nvidia", "modelID": "meta/llama-3.3-70b-instruct" }
  ],
  "retryPolicy": {
    "maxRetries": 5,
    "strategy": "exponential",
    "baseDelayMs": 2000,
    "maxDelayMs": 60000,
    "jitterEnabled": true,
    "jitterFactor": 0.25
  },
  "circuitBreaker": {
    "enabled": true,
    "failureThreshold": 5,
    "resetTimeoutMs": 120000,
    "halfOpenMaxAttempts": 2
  },
  "errorClassification": {
    "retryable": ["429", "500", "502", "503", "504", "timeout", "connection_error"],
    "auth": ["401", "403", "forbidden", "unauthorized"],
    "quota": ["quotaexceeded", "quota limit", "quota exceed", "usage quota"],
    "permanent": ["400", "content policy", "content_filter", "moderation"]
  },
  "configReload": { "enabled": true }
}